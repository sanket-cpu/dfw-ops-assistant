# DFW Airport Operations Copilot - Environment Variables
# Copy this file to .env and fill in your values

# Required: Your OpenAI API key (get one at https://platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom CORS origins (comma-separated, only needed if you're NOT using Docker)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
